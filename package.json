  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.17.0",
    "ffmpeg-static": "5.3.0",
    "ws": "8.22.0"
  },
  "overrides": {
    "unifi-protect": {
      "undici": "8.12.3"
    }
