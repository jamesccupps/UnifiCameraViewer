{
  "name": "protect-panes",
  "productName": "Protect Panes",
  "version": "1.2.0",
  "description": "Free-floating UniFi Protect live-view windows, one per camera, across multiple consoles.",
  "license": "MIT",
  "author": "James Cupps",
  "homepage": "https://github.com/jamesccupps/UnifiCameraViewer",
  "repository": {
    "type": "git",
